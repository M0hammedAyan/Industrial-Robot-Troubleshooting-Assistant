# Hugging Face / model settings
# Preferred when download/VRAM allow: Qwen/Qwen2.5-3B-Instruct or Qwen/Qwen2.5-1.5B-Instruct
# Reliable default for first local run:
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
FALLBACK_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVICE=auto
LOAD_IN_4BIT=true
MAX_NEW_TOKENS=512
TEMPERATURE=0.2
TOP_P=0.9

# Retrieval / chunking
TOP_K=5
CHUNK_SIZE=600
CHUNK_OVERLAP=120

# Paths (relative to project root)
DOCUMENT_PATH=data/manuals
VECTOR_STORE_PATH=vector_store
LOG_DIR=logs
